{
  "name": "limito",
  "version": "0.3.0",
  "description": "Fast, tiny rate limiter for Node, Bun, Deno and the edge",
  "type": "module",
  "license": "MIT",
  "author": "SleepyDaniel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SleepyDaniel/limito.git"
  },
  "keywords": [
    "rate-limit",
    "rate-limiter",
    "ratelimit",
    "gcra",
    "throttle"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./redis": "./dist/redis.js",
    "./hono": "./dist/hono.js",
    "./express": "./dist/express.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@types/express": "4 || 5",
    "express": "4 || 5",
    "hono": "^4"
  },
  "peerDependenciesMeta": {
    "@types/express": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "workspaces": [
    "bench"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "size": "size-limit",
    "bench": "bun run build && bun run --cwd bench all",
    "release": "bumpp",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@size-limit/preset-small-lib": "^14.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "bumpp": "^12.3.0",
    "express": "^5.2.1",
    "hono": "^4.13.9",
    "ioredis": "^6.0.0",
    "publint": "^0.3.24",
    "redis": "^6.2.1",
    "size-limit": "^14.0.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "size-limit": [
    {
      "name": "limito",
      "path": "dist/index.js",
      "import": "{ limito }",
      "limit": "1 kB"
    },
    {
      "name": "limito + headers",
      "path": "dist/index.js",
      "limit": "1.1 kB"
    },
    {
      "name": "limito/redis",
      "path": "dist/redis.js",
      "limit": "1 kB"
    },
    {
      "name": "limito/hono",
      "path": "dist/hono.js",
      "limit": "400 B"
    },
    {
      "name": "limito/express",
      "path": "dist/express.js",
      "limit": "400 B"
    }
  ]
}
